# ── Service ──────────────────────────────────────────────────────────────────
APP_NAME=multi-academy-ai-service
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8010

# Shared secret: NestJS school server signs inbound service requests (HS256).
SERVICE_JWT_SECRET=change-me-in-production
SERVICE_JWT_AUDIENCE=mas-ai-service
SERVICE_JWT_ISSUER=mas-school-server

# NestJS school server base URL (tool callbacks, domain reads when needed).
SCHOOL_SERVER_BASE_URL=http://localhost:8001
SCHOOL_SERVER_M2M_TOKEN=

# ── Neon Postgres (AI service state: sessions, jobs, audit, ingestion) ───────
DATABASE_URL=postgresql+psycopg://user:pass@ep-xxx.us-east-1.aws.neon.tech/mas_ai?sslmode=require

# ── Neon / S3-compatible object storage (raw docs, chunk artifacts, exports) ───
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=mas-ai-documents
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=

# ── Pinecone (tenant-scoped vector indexes) ──────────────────────────────────
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=mas-ai
PINECONE_NAMESPACE_PREFIX=tenant

# Embedding model (OpenAI-compatible or dedicated embed endpoint).
EMBEDDING_PROVIDER=nvidia
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
EMBEDDING_DIMENSION=1024

# ── LLM providers (keys live HERE — not in the control-plane vault) ───────────
# Control console only pushes providerId + default model to school servers.
# Set ONE of the keys below (nvapi-* preferred for NVIDIA NIM).
LLM_PROVIDER=nvidia
LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# NVIDIA NIM (build.nvidia.com) — nvapi-* keys use integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
# Kilo AI Gateway (optional alternative) — JWT from kilo.ai
KILO_API_KEY=
KILO_BASE_URL=https://api.kilo.ai/api/gateway

# Optional alternates (leave blank until enabled in control plane).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── Observability ─────────────────────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mas-ai-service
SENTRY_DSN=

# ── Rate limits & safety ───────────────────────────────────────────────────────
MAX_MESSAGES_PER_SESSION=40
MAX_MESSAGE_CHARS=8000
MAX_RAG_CHUNKS=12
REQUEST_TIMEOUT_SECONDS=45
