# Copy to .env for local runs. Every setting is MASMS_<NAME>; see src/masms/infrastructure/config/settings.py.
MASMS_ENVIRONMENT=development
MASMS_LOG_JSON=false
MASMS_DATABASE_URL=postgresql+asyncpg://masms_app:app@localhost:5432/masms
# MASMS_DATABASE_READ_URL=postgresql+asyncpg://masms_app:app@replica:5432/masms
MASMS_REDIS_URL=redis://localhost:6379/0
# Generate with: python -c "from masms.infrastructure.security.tokens import generate_private_key_pem as g; print(g())"
# MASMS_JWT_PRIVATE_KEY_PEM=
MASMS_SECRET_PEPPER=replace-with-32-plus-random-characters
MASMS_CORS_SCHOOL_ORIGINS=["http://localhost:3000"]
MASMS_CORS_PLATFORM_ORIGINS=["http://localhost:3100"]
MASMS_SCHOOL_APP_URL=http://localhost:3000
MASMS_EMAIL_PROVIDER=log

# AES-256-GCM key for secrets stored encrypted (MFA seeds). Generate with:
#   python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip('='))"
MASMS_DATA_KEYS={"d1":"replace-with-generated-key"}
MASMS_DATA_KEY_ID=d1

# Private files (payment receipts, photos). Development keeps them in a local folder.
MASMS_OBJECT_STORE=local
MASMS_OBJECT_STORE_PATH=./var/objects
# Production: Neon Object Storage (S3-compatible). `neon env pull` writes the AWS_* values below,
# which are read as-is; the MASMS_OBJECT_STORE_* names work too.
# MASMS_OBJECT_STORE=s3
# MASMS_OBJECT_STORE_BUCKET=masms-private
# AWS_ENDPOINT_URL_S3=https://br-xxxx.storage.c-2.us-east-2.aws.neon.tech
# AWS_REGION=us-east-2
# AWS_ACCESS_KEY_ID=nak_live_...
# AWS_SECRET_ACCESS_KEY=nsk_live_...

# Online payments. Each school connects its own Paystack account in the app; no platform keys.
# Public URL of this API: the webhook address schools paste into their Paystack dashboard.
MASMS_PUBLIC_API_URL=http://localhost:8000
# Where Paystack sends the parent back after paying (defaults to <school app>/fees/payments/return).
# MASMS_PAYMENT_CALLBACK_URL=
# Accept sk_test_ keys. Must be false in production.
MASMS_PAYMENTS_ALLOW_TEST_KEYS=true
