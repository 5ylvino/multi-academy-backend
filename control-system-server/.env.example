# Multi-Academy Control System — server configuration
# Copy to .env and adjust. Never commit real production secrets.

ENVIRONMENT=development
DEBUG=true
APP_NAME=Multi-Academy Control System

# Neon PostgreSQL in staging/production, e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@host/dbname?sslmode=require
# Pooled Neon hosts (*-pooler.*) are supported. Do not add options=statement_timeout
# to the URL — the app SETs it after connect (Neon rejects it as a startup param).
DATABASE_URL=sqlite:///./control.db
# Pool knobs for Neon/Postgres (ignored on SQLite). Size for one replica.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=15000

# Staff JWT (must be ≥ 32 bytes). Separate issuer from school Nest JWTs.
# This value is on the production-boot denylist — replace it before staging/prod.
JWT_SECRET=change-me-control-plane-secret-32b!
JWT_ISSUER=multi-academy-control
JWT_AUDIENCE=control-staff
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
STAFF_IDLE_TIMEOUT_MINUTES=30

# m2m tokens issued to Nest school servers
M2M_JWT_AUDIENCE=control-m2m
M2M_TOKEN_MINUTES=15

# Separate rate-limit budgets (requests / rolling 60s per client IP)
RATE_LIMIT_STAFF_PER_MINUTE=120
RATE_LIMIT_M2M_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=20

# When true, staff API requires an active IP allowlist entry (DB /settings)
IP_ALLOWLIST_ENFORCED=false

# Number of trusted reverse proxies in front of the app. X-Forwarded-For is
# ignored when 0 (prevents spoofing). Set to 1 behind a single load balancer,
# 2 behind Cloudflare + LB, etc.
TRUSTED_PROXY_COUNT=0

# SaaS invoice PDF issuer line
INVOICE_ISSUER_NAME=Multi-Academy Platform

# Fernet key (url-safe base64, 32 bytes) for provider secret envelope encryption.
# REQUIRED outside development — startup refuses to boot without it.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# Control web + school client origins (JSON array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3100"]

RUNTIME_CONFIG_TTL_SECONDS=60

# Phase B — dunning grace period (days). Maps to Settings.dunning_grace_days
# and is passed into run_dunning_pass by the billing worker.
DUNNING_GRACE_DAYS=7

# Redis URL for shared rate limits + multi-replica coordination (optional locally;
# in-memory buckets are used when unset — fine for single-process dev)
REDIS_URL=redis://localhost:6379/0

# Nest config invalidation webhook (optional — worker marks published locally if unset)
# Point at school Nest: http://localhost:8001/api/v1/internal/control/config-changed
NEST_CONFIG_WEBHOOK_URL=
NEST_WEBHOOK_SECRET=dev-control-webhook-secret-change-me

# In-process workers (billing invoices/dunning/offboard wipes + outbox drain).
# With multiple replicas set WORKERS_ENABLED=true on exactly one of them.
WORKERS_ENABLED=true
BILLING_WORKER_ENABLED=true
BILLING_WORKER_INTERVAL_SECONDS=300
WORKER_SHUTDOWN_TIMEOUT_SECONDS=20

# create_all() on boot is convenient locally. Set false in staging/production so
# `alembic upgrade head` is the only schema authority.
AUTO_CREATE_SCHEMA=true

# Observability
SENTRY_DSN=
LOG_JSON=false

# Phase C — dual-control for destructive actions.
# Omit to auto-enable when ENVIRONMENT=production; set true/false to override.
DUAL_CONTROL_REQUIRED=false
DUAL_CONTROL_EXPIRY_HOURS=24
STATUS_PAGE_TITLE=Multi-Academy Status
STATUS_PAGE_URL=http://localhost:8000/public/v1/status

# First-boot owner account (created only if no platform user exists)
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=ChangeMe123!

# First-boot Nest m2m client (created if client_id missing). Mirror these on Nest.
BOOTSTRAP_M2M_CLIENT_ID=svc_nest_dev_local
BOOTSTRAP_M2M_CLIENT_SECRET=dev-nest-m2m-secret-change-me-in-prod
BOOTSTRAP_M2M_NAME=Nest school server (local)
