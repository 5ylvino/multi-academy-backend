# Multi-Academy school Nest API — example env
# Copy to .env / .env.development and fill secrets.

NODE_ENV=development
PORT=8001

# CORS (comma-separated). Older typo CORS_ORGINS is still accepted.
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:5173,http://127.0.0.1:5173,https://mas.ng,https://www.mas.ng

# Required — AES key material (any string; hashed to 32 bytes if not hex/base64-32)
ENCRYPTION_KEY=dev-school-encryption-key-change-me

# Required in production (NODE_ENV=production). School JWT issuer (≠ control).
JWT_SECRET=dev-school-jwt-secret-change-me-32b
# ACCESS_TOKEN_SECRET=   # optional alias for JWT_SECRET
JWT_ISSUER=mas-school-server
JWT_AUDIENCE=mas-school-api
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_SECONDS=604800

# Nest's local tenant registry DB (Postgres / Neon)
CONTROL_DB_URL=postgresql://user:pass@host/academy_control?sslmode=require
# Run `typeorm migration:run`/the deployment migration job before startup.
# Keep false in Docker and production; true is only for legacy local setups.
CONTROL_DB_AUTO_MIGRATE=false

# Used when provisioning new tenant databases
POSTGRES_SUPER_URL=postgresql://user:pass@host/academy_db?sslmode=require

# Force TLS for managed Postgres
PG_SSL=true

# FastAPI platform control API (feature flags, providers, blocks)
# Leave CONTROL_M2M_* empty to run with foundation-default flags only.
CONTROL_API_URL=http://localhost:8000
CONTROL_M2M_CLIENT_ID=svc_nest_dev_local
CONTROL_M2M_CLIENT_SECRET=dev-nest-m2m-secret-change-me-in-prod
# Neon dev can take 12–15s on a cold runtime-config pull; keep above that.
CONTROL_API_TIMEOUT_MS=20000
CONTROL_CONFIG_TTL_SECONDS=60
# How long past the TTL a cached config may still be served while a background
# refresh runs. Real changes still arrive immediately via the control webhook.
CONTROL_CONFIG_STALE_CEILING_SECONDS=300
# Shared secret for control → Nest outbox webhook (X-Control-Webhook-Secret)
CONTROL_WEBHOOK_SECRET=dev-control-webhook-secret-change-me

# Optional shared Redis cache for tenant runtime config + refresh revocation
# (required for multi-instance Nest). When unset, in-memory only (single-process).
# REDIS_URL=redis://localhost:6379
# RUNTIME_CONFIG_REDIS_PREFIX=mas:runtime-config
# LIST_CACHE_TTL_MS=45000

# Tenant DB pool cache (one TypeORM DataSource per active tenant).
# TENANT_DB_MAX_CACHED=20
# TENANT_DB_EVICT_IDLE_MS=600000

# Public app URL used in payment callback links (Paystack redirect)
# CLIENT_APP_URL is also used below for WebAuthn origin alignment.

# Payment provider secrets live in the control vault (not here).
# Register secret_key for Paystack / api_key+username for Africa's Talking
# via control web → Providers → rotate secrets.

# Optional local fallbacks (prefer control vault). Used only when vault empty.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_PUBLIC_KEY=
# FLUTTERWAVE_WEBHOOK_SECRET=
# FLUTTERWAVE_MODE=sandbox
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# KILO_API_KEY=
# KILO_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# KILO_BASE_URL=https://api.kilo.ai/api/gateway

# Standalone Python AI microservice (multi-academy-ai-service)
# Leave AI_SERVICE_URL empty to keep inline Nest LLM adapters.
# AI_SERVICE_URL=http://localhost:8010
AI_SERVICE_JWT_SECRET=change-me-in-production
AI_SERVICE_JWT_ISSUER=mas-school-server
AI_SERVICE_JWT_AUDIENCE=mas-ai-service

# Standalone tutoring marketplace microservice (multi-academy-tutoring-service)
# TUTORING_SERVICE_URL=http://localhost:8011
TUTORING_SERVICE_JWT_SECRET=change-me-in-production
TUTORING_SERVICE_JWT_ISSUER=mas-school-server
TUTORING_SERVICE_JWT_AUDIENCE=mas-tutoring-service

# Standalone payment gateway microservice (multi-academy-payment-service)
# Leave PAYMENT_SERVICE_URL empty to keep inline Nest payment adapters.
# PAYMENT_SERVICE_URL=http://localhost:8012
PAYMENT_SERVICE_JWT_SECRET=change-me-in-production
PAYMENT_SERVICE_JWT_ISSUER=mas-school-server
PAYMENT_SERVICE_JWT_AUDIENCE=mas-payment-service

# Portal read service (multi-academy-portal-read-service) — cached dashboards
# PORTAL_READ_SERVICE_URL=http://localhost:8013
# PORTAL_READ_SERVICE_JWT_SECRET=change-me-in-production
# PORTAL_READ_SERVICE_JWT_ISSUER=mas-school-server
# PORTAL_READ_SERVICE_JWT_AUDIENCE=mas-portal-read-service

# Async worker (multi-academy-worker-service) — notifications + report PDF
# WORKER_SERVICE_URL=http://localhost:8014
# WORKER_SERVICE_JWT_SECRET=change-me-in-production
# WORKER_SERVICE_JWT_ISSUER=mas-school-server
# WORKER_SERVICE_JWT_AUDIENCE=mas-worker-service

# Internal service JWT (portal-read/worker → Nest /internal/*)
# SERVICE_JWT_SECRET=change-me-in-production
# INTERNAL_SERVICE_JWT_AUDIENCE=mas-school-internal
# INTERNAL_SERVICE_JWT_ISSUER=mas-school-server

# Thin edge API — npm run start:edge:dev
# EDGE_PORT=8001

# Slow request logging threshold (ms)
# SLOW_REQUEST_MS=500

# WebAuthn / passkey biometrics
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=MA-SMS
WEBAUTHN_ORIGIN=http://localhost:3000
CLIENT_APP_URL=http://localhost:3000
