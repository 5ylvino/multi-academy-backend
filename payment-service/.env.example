PORT=8012
# Use "production" in live deploys — enforces control-plane + non-default JWT secret
APP_ENV=development

# Service JWT — must match Nest PAYMENT_SERVICE_* settings
SERVICE_JWT_SECRET=change-me-in-production
SERVICE_JWT_AUDIENCE=mas-payment-service
SERVICE_JWT_ISSUER=mas-school-server

# Payment service database (checkout audit, context bindings, webhook dedup)
DATABASE_URL=postgresql+psycopg://localhost/mas_payments

# Control plane — provider secrets + default gateway (same m2m client as Nest)
CONTROL_API_URL=http://localhost:8000
CONTROL_M2M_CLIENT_ID=
CONTROL_M2M_CLIENT_SECRET=
CONTROL_SECRETS_TTL_SECONDS=60

DEFAULT_CURRENCY=NGN
