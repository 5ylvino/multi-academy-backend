APP_NAME=multi-academy-tutoring-service
APP_ENV=development
PORT=8011

SERVICE_JWT_SECRET=change-me-in-production
SERVICE_JWT_AUDIENCE=mas-tutoring-service
SERVICE_JWT_ISSUER=mas-school-server

DATABASE_URL=postgresql+psycopg://user:pass@ep-xxx.us-east-1.aws.neon.tech/mas_tutoring?sslmode=require

AI_SERVICE_URL=http://localhost:8010
AI_SERVICE_JWT_SECRET=change-me-in-production

# Control plane — tutoring policy source of truth (falls back to env defaults when unset)
CONTROL_API_URL=http://localhost:8000
CONTROL_M2M_CLIENT_ID=
CONTROL_M2M_CLIENT_SECRET=
CONTROL_SECRETS_TTL_SECONDS=60

# Fallback defaults when control plane is not configured (local dev only)
PLATFORM_FEE_PERCENT=15
DEFAULT_CURRENCY=NGN
